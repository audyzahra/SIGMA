# SIGMA AI Service - contoh konfigurasi
# Salin menjadi .env lalu isi nilainya. JANGAN commit key asli.

# NASA FIRMS (hotspot aktif) - daftar key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv/
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT
FIRMS_RADIUS_KM=10
FIRMS_DAYS=2

# NASA POWER (cuaca harian) - endpoint publik, tidak memerlukan key
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/
NASA_POWER_LOOKBACK_DAYS=10

# Cache & timeout
NASA_CACHE_MINUTES=30
AI_REQUEST_TIMEOUT=20

# Logging
AI_LOG_LEVEL=INFO

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

